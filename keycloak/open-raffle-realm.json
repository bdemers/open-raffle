{
  "realm": "open-raffle",
  "displayName": "Open Raffle",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "open-raffle",
  "roles": {
    "realm": [
      {
        "name": "ORGANIZER",
        "description": "Runs the events they are listed on: participants, prizes, the draw"
      },
      {
        "name": "ADMIN",
        "description": "Manages events and organizers; has everything ORGANIZER has",
        "composite": true,
        "composites": {
          "realm": [
            "ORGANIZER"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "open-raffle-app",
      "name": "Open Raffle",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:8080",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:8081/*",
        "http://127.0.0.1:8081/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080",
        "http://localhost:8081",
        "http://127.0.0.1:8081"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*##http://127.0.0.1:8080/*##http://localhost:8081/*##http://127.0.0.1:8081/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "organizer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Raffle",
      "lastName": "Organizer",
      "email": "organizer@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "organizer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "helper",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Helpful",
      "lastName": "Organizer",
      "email": "helper@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "helper",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ORGANIZER"
      ]
    }
  ],
  "displayNameHtml": "\ud83c\udf9f\ufe0f Open Raffle"
}
