#!/usr/bin/env bash
# Runs Snyk's dependency and code scans before every push; a finding blocks the push.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip for one push:       git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v snyk >/dev/null 2>&1; then
    echo "pre-push: snyk CLI not found (brew install snyk-cli, then snyk auth); skipping the scan." >&2
    exit 0
fi

echo "pre-push: snyk test (dependencies)…"
snyk test
echo "pre-push: snyk code test (static analysis)…"
snyk code test
echo "pre-push: snyk found nothing; pushing."
